{
  "name": "fulmetry",
  "version": "0.2.0",
  "description": "A Bun-first circuit project framework built on tscircuit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fulmetry/fulmetry.git"
  },
  "homepage": "https://github.com/Fulmetry/fulmetry#readme",
  "bugs": {
    "url": "https://github.com/Fulmetry/fulmetry/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "fulmetry": "src/cli/fulmetry.js"
  },
  "files": [
    "src",
    "compatibility",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": ["darwin"],
  "cpu": ["arm64"],
  "exports": {
    ".": "./src/index.ts",
    "./artifacts": "./src/artifacts/manifest.ts",
    "./artifacts/promotion": "./src/artifacts/promotion.ts",
    "./authoring": "./src/authoring.ts",
    "./cli": "./src/cli/index.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./electrical": "./src/electrical.ts",
    "./external-tools": "./src/external-tools.ts",
    "./engine-identity": "./src/engine-identity.ts",
    "./upstream-upgrade": "./src/upstream-upgrade.ts",
    "./upgrade/engine-package": "./src/upgrade/engine-package.ts",
    "./upgrade/dependency-lock": "./src/upgrade/dependency-lock.ts",
    "./upgrade/path-transaction": "./src/upgrade/path-transaction.ts",
    "./upgrade/directory-transaction": "./src/upgrade/directory-transaction.ts",
    "./upgrade/refresh-guard": "./src/upgrade/refresh-guard.ts",
    "./upgrade/runtime": "./src/upgrade/runtime.ts",
    "./upgrade/platforms": "./src/upgrade/platforms.ts",
    "./upgrade/runtime-evidence": "./src/upgrade/runtime-evidence.ts",
    "./upgrade/implementation-identity": "./src/upgrade/implementation-identity.ts",
    "./upgrade/packed-consumer": "./src/upgrade/packed-consumer.ts",
    "./manufacturing": "./src/manufacturing/index.ts",
    "./licenses": "./src/licenses.ts",
    "./kicad": "./src/kicad/index.ts",
    "./project": "./src/project/index.ts",
    "./routes": "./src/routes.ts",
    "./routing": "./src/routing/index.ts",
    "./result": "./src/result.ts",
    "./status": "./src/status.ts",
    "./units": "./src/units.ts",
    "./version": "./src/version.ts",
    "./standards": "./src/standards.ts",
    "./sourcing": "./src/sourcing.ts",
    "./server": "./src/server/index.ts",
    "./simulation": "./src/simulation/index.ts"
  },
  "scripts": {
    "fulmetry": "bun ./src/cli/bin.ts",
    "prepack": "bun ./scripts/validate-package-boundary.ts",
    "test": "bun run test:regular && bun run test:cli && bun run test:heavy:accept-tscircuit-upgrade && bun run test:heavy:artifact-manifest && bun run test:heavy:manufacturing-properties && bun run test:heavy:semantic-properties && bun run test:heavy:manufacturing-verify && bun run test:heavy:production-promotion && bun run test:heavy:scaffold && bun run test:heavy:server && bun run test:performance",
    "test:regular": "bun ./scripts/run-ci-gate.ts regular-01 && bun ./scripts/run-ci-gate.ts regular-02 && bun ./scripts/run-ci-gate.ts regular-03 && bun ./scripts/run-ci-gate.ts regular-04 && bun ./scripts/run-ci-gate.ts regular-05 && bun ./scripts/run-ci-gate.ts regular-06 && bun ./scripts/run-ci-gate.ts regular-07 && bun ./scripts/run-ci-gate.ts regular-08 && bun ./scripts/run-ci-gate.ts regular-09 && bun ./scripts/run-ci-gate.ts regular-10 && bun ./scripts/run-ci-gate.ts regular-11 && bun ./scripts/run-ci-gate.ts regular-12 && bun ./scripts/run-ci-gate.ts regular-13 && bun ./scripts/run-ci-gate.ts regular-14 && bun ./scripts/run-ci-gate.ts regular-15 && bun ./scripts/run-ci-gate.ts regular-16",
    "test:cli": "bun ./scripts/run-ci-gate.ts cli-integration",
    "test:heavy:accept-tscircuit-upgrade": "bun ./scripts/run-ci-gate.ts accept-tscircuit-upgrade",
    "test:heavy:artifact-manifest": "bun ./scripts/run-ci-gate.ts artifact-manifest",
    "test:heavy:manufacturing-properties": "bun ./scripts/run-ci-gate.ts manufacturing-properties",
    "test:heavy:semantic-properties": "bun ./scripts/run-ci-gate.ts semantic-properties",
    "test:heavy:manufacturing-verify": "bun ./scripts/run-ci-gate.ts manufacturing-verify",
    "test:heavy:production-promotion": "bun ./scripts/run-ci-gate.ts production-promotion",
    "test:heavy:scaffold": "bun ./scripts/run-ci-gate.ts scaffold",
    "test:heavy:server": "bun ./scripts/run-ci-gate.ts server",
    "test:live:ngspice": "bun ./scripts/run-ci-gate.ts ngspice-live",
    "test:live:kicad": "bun ./scripts/live-kicad-ci.ts",
    "test:performance": "bun ./scripts/run-ci-gate.ts performance",
    "performance:validate": "bun ./scripts/validate-performance-report.ts",
    "test:packed": "bun ./scripts/run-ci-gate.ts packed-e2e",
    "typecheck": "bun ./scripts/run-ci-gate.ts typecheck",
    "skills:validate": "bun ./scripts/validate-agent-skills.ts",
    "upgrade:tscircuit": "bun ./scripts/review-tscircuit-upgrade.ts",
    "accept:tscircuit": "bun ./scripts/accept-tscircuit-upgrade.ts",
    "qualify:tscircuit-runtime": "bun ./scripts/qualify-tscircuit-runtime.ts"
  },
  "dependencies": {
    "@tscircuit/alphabet": "0.0.25",
    "circuit-json": "0.0.464",
    "circuit-json-to-bom-csv": "0.0.14",
    "circuit-json-to-gerber": "0.0.90",
    "circuit-json-to-kicad": "0.0.171",
    "circuit-json-to-pnp-csv": "0.0.9",
    "circuit-to-svg": "0.0.400",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dsn-converter": "0.0.90",
    "format-si-prefix": "0.3.2",
    "gerber-parser": "4.2.7",
    "kicadts": "0.0.53",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "0.179.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.179.0",
    "tscircuit": "0.0.2261"
  },
  "peerDependencies": {
    "tscircuit": "0.0.2261"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "license": "MIT"
}
