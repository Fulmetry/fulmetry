{
  "$schema": "https://docs.page/schema.json",
  "name": "Fulmetry",
  "description": "Build circuits with your coding agent using composable TypeScript and reviewable evidence.",
  "socialPreview": false,
  "theme": {
    "defaultTheme": "light",
    "primary": "#87ea5c",
    "primaryLight": "#083400",
    "primaryDark": "#87ea5c",
    "backgroundLight": "#ffffff",
    "backgroundDark": "#083400"
  },
  "header": {
    "showName": true,
    "showThemeToggle": true,
    "showGitHubCard": true,
    "links": [
      {
        "title": "Website",
        "href": "https://fulmetry.com/"
      },
      {
        "title": "GitHub",
        "href": "https://github.com/Fulmetry/fulmetry",
        "cta": true
      }
    ]
  },
  "anchors": [
    {
      "icon": "github",
      "title": "Source code",
      "href": "https://github.com/Fulmetry/fulmetry"
    },
    {
      "icon": "globe",
      "title": "Fulmetry website",
      "href": "https://fulmetry.com/"
    }
  ],
  "sidebar": [
    {
      "group": "Start here",
      "pages": [
        { "title": "Introduction", "href": "/" },
        { "title": "Getting started", "href": "/getting-started" },
        { "title": "Project structure", "href": "/project-structure" }
      ]
    },
    {
      "group": "Build with Fulmetry",
      "pages": [
        { "title": "Author circuits", "href": "/authoring" },
        { "title": "Commands", "href": "/commands" },
        { "title": "Results and statuses", "href": "/results-and-statuses" }
      ]
    },
    {
      "group": "Tools and agents",
      "pages": [
        { "title": "External tools", "href": "/external-tools" },
        { "title": "Agent access", "href": "/agent-access" }
      ]
    },
    {
      "group": "Project",
      "pages": [
        { "title": "Current limitations", "href": "/limitations" },
        { "title": "Product requirements", "href": "https://github.com/Fulmetry/fulmetry/blob/main/PRODUCT_REQUIREMENTS.md" }
      ]
    }
  ],
  "content": {
    "headerDepth": 3,
    "zoomImages": false,
    "automaticallyInferNextPrevious": true,
    "showPageTitle": true,
    "showPageImage": false
  },
  "seo": {
    "noindex": false
  },
  "social": {
    "website": "https://fulmetry.com/",
    "github": "https://github.com/Fulmetry"
  },
  "og": {
    "github": true
  },
  "mcp": {
    "enabled": true
  }
}
